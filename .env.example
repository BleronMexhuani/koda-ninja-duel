# Copy to .env for local development (go run). docker-compose sets these itself.
DATABASE_URL=postgres://koda:koda@localhost:5432/koda?sslmode=disable
PORT=8080
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Set to true behind a reverse proxy so rate limiting sees real client IPs.
TRUST_PROXY=false
